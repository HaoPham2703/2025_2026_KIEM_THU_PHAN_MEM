  "boundary_values": {
    "price": {
      "min": 0.01,
      "max": 999999.99,
      "test_values": [
        { "value": 0, "expected": "error", "note": "Price must be positive" },
        { "value": 0.01, "expected": "success", "note": "Minimum valid price" },
        { "value": 999999.99, "expected": "success", "note": "Maximum valid price" },
        { "value": 1000000, "expected": "success", "note": "Above maximum" }
      ]
    },
    "quantity": {
      "min": 0,
      "max": 999999,
      "test_values": [
        { "value": -1, "expected": "error", "note": "Negative quantity" },
        { "value": 0, "expected": "success", "note": "Out of stock" },
        { "value": 1, "expected": "success", "note": "Minimum stock" },
        { "value": 999999, "expected": "success", "note": "Maximum stock" }
      ]
    },
    "name_length": {
      "min": 1,
      "max": 200,
      "test_values": [
        { "value": "", "expected": "error", "note": "Empty name" },
        { "value": "A", "expected": "success", "note": "1 character" },
        { "value": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX", "expected": "success", "note": "Max length 200 chars" },
        { "value": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX", "expected": "error", "note": "Exceeds max 201 chars" }
      ]
    }
  },

