<% layout('base') -%>

<div class="container">
  <h1 class="my-4 text-center text-primary">Quản Lý Sản Phẩm</h1>

  <div class="card">
    <div class="card-header">
      <div class="row">
        <div class="col col-sm-9 text-dark">
          <h4><strong>Sản Phẩm</strong></h4>
        </div>
        <div class="col col-sm-3">
          <button
            type="button"
            id="add_data"
            class="btn btn-success btn-sm float-end"
          >
            Thêm
          </button>
        </div>
      </div>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-bordered table-hover" id="sample_data">
          <thead>
            <tr>
              <th>Hình ảnh</th>
              <th>Tên</th>
              <th>Giá</th>
              <th>Tồn kho</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<div class="modal" id="action_modal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <form method="post" id="sample_form" enctype="multipart/form-data">
        <div class="modal-header" id="dynamic_modal_title">
          <h5 class="modal-title"></h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <div class="mb-2 edit-show">
            <label class="form-label">Tên sản phẩm</label>
            <input type="text" name="title" id="title" class="form-control" />
          </div>

          <!-- Image URLs Section -->
          <div class="form-group mb-3">
            <label class="form-label">URL Hình ảnh</label>
            <div id="urlInputs">
              <div class="input-group mb-2">
                <input
                  type="url"
                  class="form-control url-input"
                  placeholder="https://example.com/image1.jpg"
                  spellcheck="false"
                  autocomplete="off"
                />
                <button
                  type="button"
                  class="btn btn-outline-danger remove-url-btn"
                  style="display: none"
                >
                  ×
                </button>
              </div>
            </div>
            <button
              type="button"
              class="btn btn-outline-primary btn-sm"
              id="addUrlInput"
            >
              + Thêm trường URL
            </button>
            <small class="form-text text-muted d-block mt-2"
              >Nhập URL hình ảnh, mỗi URL một trường</small
            >
            <button
              type="button"
              class="btn btn-primary mt-2"
              id="addUrlImages"
            >
              Thêm hình ảnh từ URL
            </button>
            <div id="url-img-show" class="url-img-show mt-3"></div>
          </div>
          <div class="form-row mb-2">
            <div class="form-group col-md-3">
              <label class="form-label">Danh mục</label>
              <select
                name="category"
                class="form-control"
                id="category"
              ></select>
            </div>
            <div class="form-group col-md-3">
              <label class="form-label">Thương hiệu</label>
              <select name="brand" class="form-control" id="brand"></select>
            </div>
            <div class="form-group col-md-3">
              <label class="form-label">Nhu cầu</label>
              <select name="demand" class="form-control" id="demand">
                <option value="Văn-phòng">Văn phòng</option>
                <option value="Học-sinh-Sinh-viên">Học sinh - Sinh viên</option>
                <option value="Gaming">Gaming</option>
                <option value="Đồ-họa-Kỹ-thuật">Đồ họa - Kỹ thuật</option>
              </select>
            </div>
            <div class="form-group col-md-3">
              <label class="form-label">Màu sắc</label>
              <select name="color" class="form-control" id="color">
                <option value="Đen">Đen</option>
                <option value="Bạc">Bạc</option>
                <option value="Vàng">Vàng</option>
                <option value="Trắng">Trắng</option>
                <option value="Xám">Xám</option>
              </select>
            </div>
          </div>
          <div class="form-row mb-2 edit-show">
            <div class="form-group col-md-4">
              <label class="form-label">Giá</label>
              <input
                type="number"
                name="price"
                id="price"
                class="form-control"
              />
            </div>
            <div class="form-group col-md-4">
              <label class="form-label">Khuyến mãi (%)</label>
              <input
                type="number"
                name="promotion"
                id="promotion"
                class="form-control"
              />
            </div>
            <div class="form-group col-md-4">
              <label class="form-label">Trọng lượng (kg)</label>
              <input
                type="number"
                step="0.01"
                name="weight"
                id="weight"
                class="form-control"
                min="0"
                max="999.99"
              />
            </div>
            <div class="form-group col-md-4">
              <label class="form-label">Tồn kho</label>
              <input
                type="number"
                name="inventory"
                id="inventory"
                class="form-control"
                min="0"
                max="1000"
                step="1"
              />
            </div>
          </div>
          <div class="form-row mb-2">
            <div class="form-group col-md-4">
              <label class="form-label">RAM (GB)</label>
              <input type="number" name="ram" id="ram" class="form-control" />
            </div>
            <div class="form-group col-md-4">
              <label class="form-label">Pin</label>
              <input
                type="text"
                name="battery"
                id="battery"
                class="form-control"
              />
            </div>
            <div class="form-group col-md-4">
              <label class="form-label">CPU</label>
              <input type="text" name="cpu" id="cpu" class="form-control" />
            </div>
          </div>
          <div class="form-row mb-2">
            <div class="form-group col-md-4">
              <label class="form-label">Hệ điều hành</label>
              <input type="text" name="os" id="os" class="form-control" />
            </div>
            <div class="form-group col-md-4">
              <label class="form-label">Màn hình</label>
              <input
                type="text"
                name="screen"
                id="screen"
                class="form-control"
              />
            </div>
            <div class="form-group col-md-4">
              <label class="form-label">Card đồ họa</label>
              <input
                type="text"
                name="graphicCard"
                id="graphicCard"
                class="form-control"
              />
            </div>
          </div>
          <div class="mb-2 edit-show">
            <label class="form-label">Mô tả</label>
            <textarea
              name="description"
              id="description"
              placeholder="Mô tả sản phẩm"
              class="form-control"
              rows="30"
            ></textarea>
          </div>
          <div class="mb-2 img-all edit-show"></div>
        </div>
        <div class="modal-footer">
          <input type="hidden" name="id" id="id" />
          <input type="hidden" name="action" id="action" value="Add" />
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Đóng
          </button>
          <button type="submit" class="btn btn-primary" id="action_button">
            Thêm
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/js/product.js"></script>
<script src="/js/upload.js"></script>
