      "item": [
        {
          "name": "AUTH-001: Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.environment.set('userId', jsonData.data._id);",
                  "    console.log('✅ Signup success, token saved');",
                  "} else {",
                  "    console.log('❌ Signup failed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser{{$timestamp}}@example.com\",\n  \"password\": \"Test@12345\",\n  \"passwordConfirm\": \"Test@12345\",\n  \"name\": \"Test User\"\n}"
